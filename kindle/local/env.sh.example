#!/usr/bin/env sh

# --- Endpoint -----------------------------------------------------------
# Must be a hostname, not an IP: xh uses rustls, which refuses HTTPS to
# bare IP addresses.
export FRAME_URL=${FRAME_URL:-"https://kindleframe.monester.au/frame.png"}

# The server's READ token. This device must never hold the write token: it
# sits unattended, could be lost, and has no business changing anything.
# The server returns 403 to this token on every write endpoint.
export FRAME_TOKEN=${FRAME_TOKEN:-"set-me-to-the-read-token"}

# --- Schedule -----------------------------------------------------------
# Cron expressions, not an interval. Several may be given, separated by ';',
# and the device wakes at whichever fires first. One expression cannot cover
# this on its own: the minute field would have to be */15 for some hours and 0
# for others.
#
#   0 7-18 * * MON-FRI        hourly through the working day
#   */15 7-8 * * MON-FRI      every 15 minutes over the weekday morning
#   0 7 * * SAT,SUN           once, to pick up the weekend message
#
# The weekend needs only the one poll: the server resolves Saturday and Sunday
# to the weekend frame, and that frame does not change for the rest of the day.
#
# Nothing matches between 19:00 and 07:00, so the device sleeps the night
# through on one alarm. The screen keeps its last frame while it sleeps -
# e-ink holds the image with no power - so overnight it shows the 18:00 frame,
# including that timestamp and, after midnight, the previous day's date.
export REFRESH_SCHEDULE=${REFRESH_SCHEDULE:-"0 7-18 * * MON-FRI;*/15 7-8 * * MON-FRI;0 7 * * SAT,SUN"}

# Only feeds next-wakeup's cron maths. The device clock is UTC and it ships no
# tzdata, so nothing here affects what is printed - the server renders the
# date and decides the weekend, in its own timezone.
export TIMEZONE=${TIMEZONE:-"Australia/Melbourne"}

# --- Display ------------------------------------------------------------
# A full (flashing) refresh is triggered every Nth *actual redraw*.
# Polls that return 304 do not count, so on mostly-static content this
# flashes rarely. Lower = crisper text, more flashing.
export FULL_DISPLAY_REFRESH_RATE=${FULL_DISPLAY_REFRESH_RATE:-4}

# --- Fetch ---------------------------------------------------------------
# The radio is down during suspend and needs a few seconds after a wake, so
# the fetch retries rather than being gated behind a reachability probe. A
# ping-based pre-check is the wrong tool: it misreports any host that filters
# ICMP, which would block a request that would otherwise have succeeded.
export FETCH_ATTEMPTS=${FETCH_ATTEMPTS:-4}
export FETCH_TIMEOUT=${FETCH_TIMEOUT:-10}

# How long to wait for the radio to associate after a wake before fetching.
# The device comes back from suspend with the radio off; on a busy office AP
# it can take 15 seconds to get an address. Waiting costs a few seconds awake,
# where not waiting costs the whole refresh.
export NETWORK_WAIT=${NETWORK_WAIT:-45}

# A refresh that fails is retried on a widening delay rather than costing a
# whole scheduled interval - which, overnight or at a weekend, would leave a
# stale panel for hours. Delay is multiplied by the attempt number.
export FETCH_RETRY_DELAY=${FETCH_RETRY_DELAY:-120}
export FETCH_RETRY_MAX=${FETCH_RETRY_MAX:-3}

# How long the menu waits for a tap before restoring the current view.
export MENU_TIMEOUT=${MENU_TIMEOUT:-30}

# --- Cloudflare Access (optional) ---------------------------------------
#
# Set these when the endpoint sits behind Cloudflare Access. They are a
# *service token*: a non-interactive credential, because a headless Kindle
# cannot complete an SSO login.
#
# Scope the Access policy for this token to /frame.png alone. Then losing the
# device leaks a credential that can fetch frames and nothing else - it cannot
# reach the control page or any write endpoint, even before the read/write
# token split is considered.
#
# Leave both unset when there is no Access in front: the fetch script only
# sends them when they are set, so an empty pair costs nothing.
export CF_ACCESS_CLIENT_ID=${CF_ACCESS_CLIENT_ID:-""}
export CF_ACCESS_CLIENT_SECRET=${CF_ACCESS_CLIENT_SECRET:-""}
