# Copy to .env and adjust. Nothing here is read automatically; docker compose
# picks up .env, and `npm start` expects these in the environment.

# --- Tokens ---------------------------------------------------------------
#
# Two tokens, because the two sides have genuinely different threat models.
#
# The READ token goes in the Kindle's local/env.sh. That device sits
# unattended, may be somewhere you do not control, and could be lost - so it
# must only ever fetch frames. Every write endpoint returns 403 to it.
#
# The WRITE token sets the panel. Keep it wherever you push from: Home
# Assistant, a script, a phone shortcut. The Kindle never sees it.
#
#   openssl rand -hex 24
FRAME_READ_TOKEN=change-me-read
FRAME_WRITE_TOKEN=change-me-write

# Legacy single token, still honoured for both if the two above are unset.
# Setting only this means the Kindle can change your status.
# FRAME_TOKEN=change-me

# --- Server ---------------------------------------------------------------
PORT=8080

# Where pushed state is kept, so a restart does not blank the panel or flip
# your status. The container sets this to /app/data/state.json.
# STATE_PATH=./data/state.json

# --- Location -------------------------------------------------------------
#
# Used for the rendered date, the weather lookup, and the weekend rule. The
# Kindle cannot help with any of it: its clock is UTC and it ships no tzdata,
# so anything day-dependent is resolved here.
TZ_NAME=Australia/Melbourne
LOCATION_NAME=Melbourne
LATITUDE=-37.8136
LONGITUDE=144.9631

# Name on the in/out cards.
PERSON_NAME=JJ

# --- Weather --------------------------------------------------------------
#
# Open-Meteo, which needs no API key - that is why this service deploys
# without secret management. A weather outage does not take the frame down:
# the column degrades to a visible gap and stale readings are preferred over
# none.
WEATHER_ENABLED=true
WEATHER_CACHE_SECONDS=900
WEATHER_TIMEOUT_MS=8000

# --- Fonts ----------------------------------------------------------------
#
# Satori has no font discovery and no fallback: it renders only from the faces
# it is handed, so a character the font lacks becomes a tofu box rather than
# falling back. The container sets these to Charis SIL. Locally they are
# auto-detected, which usually finds Georgia - close metrics, but not
# identical, so long text can break lines differently. Set them explicitly if
# you need an exact match.
#
# FONT_REGULAR=/usr/share/fonts/truetype/charis/CharisSIL-Regular.ttf
# FONT_BOLD=/usr/share/fonts/truetype/charis/CharisSIL-Bold.ttf
